# entrypoint.c only needs R headers now; HDF5 headers not required.
PKG_CFLAGS =

TARGET_DIR = ./rust/target
LIBDIR     = $(TARGET_DIR)/release
STATLIB    = $(LIBDIR)/libpicklerick_r.a

# scx-core links HDF5 + zlib into libpicklerick_r.a. With the default
# vendored-hdf5 feature it builds them from source and links statically (no
# system libhdf5 / libz needed). Packagers that set HDF5_DIR (e.g. the conda
# recipe, host hdf5 1.12.*) make hdf5-metno-sys link that system library
# instead; the chunk-read ABI is then chosen from the detected version, not the
# feature (see scx-core/build.rs + h5_chunk.rs). -ldl/-lm cover the static case.
PKG_LIBS   = $(STATLIB) -ldl -lm

# scx-core is a pinned git dependency (./rust/Cargo.toml + Cargo.lock), fetched
# by cargo — not vendored in-tree. Rebuild on local source or lockfile changes.
RUST_SRC = $(shell find ./rust/src -name '*.rs' 2>/dev/null) ./rust/Cargo.toml ./rust/Cargo.lock

$(SHLIB): $(STATLIB)

$(STATLIB): $(RUST_SRC)
	cargo build --lib --release --manifest-path=./rust/Cargo.toml --target-dir=$(TARGET_DIR)
	@# When CARGO_BUILD_TARGET is set (e.g. by conda's rust toolchain
	@# activation), cargo writes to $(TARGET_DIR)/<triple>/release/ instead
	@# of $(TARGET_DIR)/release/. Copy it back to the expected location.
	@if [ ! -f $(STATLIB) ]; then \
	    found=$$(find $(TARGET_DIR) -path '*/release/libpicklerick_r.a' | head -1); \
	    if [ -n "$$found" ]; then \
	        mkdir -p $(LIBDIR); \
	        cp "$$found" $(STATLIB); \
	    fi; \
	fi

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(TARGET_DIR)
