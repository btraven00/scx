# entrypoint.c only needs R headers now; HDF5 headers not required.
PKG_CFLAGS =

TARGET_DIR = ./rust/target
LIBDIR     = $(TARGET_DIR)/release
STATLIB    = $(LIBDIR)/libpicklerick_r.a

# HDF5 + zlib are linked statically into libpicklerick_r.a via the
# vendored-hdf5 feature on the vendored scx-core (see ./rust/scx-core).
# No system libhdf5 / libz at link or load time.
PKG_LIBS   = $(STATLIB) -ldl -lm

RUST_SRC = $(shell find ./rust/src ./rust/scx-core/src -name '*.rs' 2>/dev/null) ./rust/Cargo.toml

$(SHLIB): $(STATLIB)

$(STATLIB): $(RUST_SRC)
	cargo build --lib --release --manifest-path=./rust/Cargo.toml --target-dir=$(TARGET_DIR)
	@# When CARGO_BUILD_TARGET is set (e.g. by conda's rust toolchain
	@# activation), cargo writes to $(TARGET_DIR)/<triple>/release/ instead
	@# of $(TARGET_DIR)/release/. Copy it back to the expected location.
	@if [ ! -f $(STATLIB) ]; then \
	    found=$$(find $(TARGET_DIR) -path '*/release/libpicklerick_r.a' | head -1); \
	    if [ -n "$$found" ]; then \
	        mkdir -p $(LIBDIR); \
	        cp "$$found" $(STATLIB); \
	    fi; \
	fi

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(TARGET_DIR)
