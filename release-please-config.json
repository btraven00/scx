{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "packages": {
    "crates/scx-core": {
      "release-type": "rust",
      "package-name": "scx-core",
      "extra-files": [
        {
          "type": "generic",
          "path": "/r/picklerick/src/rust/Cargo.toml"
        },
        {
          "type": "generic",
          "path": "/r/picklerick/DESCRIPTION"
        }
      ],
      "release-as": "0.6.1"
    },
    "crates/scx-cli": {
      "release-type": "rust",
      "package-name": "scx-cli",
      "release-as": "0.6.1"
    },
    "python/picklerick": {
      "release-type": "rust",
      "package-name": "picklerick-py-native",
      "component": "picklerick",
      "release-as": "0.6.1"
    }
  },
  "plugins": [
    "cargo-workspace",
    {
      "type": "linked-versions",
      "groupName": "scx",
      "components": [
        "scx-core",
        "scx-cli",
        "picklerick"
      ]
    }
  ]
}
