{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "crates/scx-core": {
      "release-type": "rust",
      "package-name": "scx-core"
    },
    "crates/scx-cli": {
      "release-type": "rust",
      "package-name": "scx-cli"
    },
    "python/picklerick": {
      "release-type": "rust",
      "package-name": "picklerick-py-native",
      "component": "picklerick"
    }
  },
  "plugins": [
    "cargo-workspace",
    {
      "type": "linked-versions",
      "groupName": "scx",
      "components": [
        "scx-core",
        "scx-cli",
        "picklerick"
      ]
    }
  ]
}
